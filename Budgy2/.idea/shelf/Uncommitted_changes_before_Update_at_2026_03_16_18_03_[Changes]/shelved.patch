+                    app:tint="@color/yellow_accent" />
+            </LinearLayout>
+
+
+
+
+
+            <!-- Note (Optional) -->
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="Notes (Optional)"
+                android:textColor="@color/text_secondary"
+                android:textSize="14sp" />
+
+            <EditText
