<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/input_background"
    android:padding="16dp">

    <!-- Category Name -->
    <TextView
        android:id="@+id/tvCategoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/yellow_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Spent Amount -->
    <TextView
        android:id="@+id/tvSpentAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/expense_red"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Status Icon and Text Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvStatusIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✅"
            android:textSize="28sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Budget Range Visualization -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMinLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Min: R0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvMaxLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Max: R0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- Progress Bar Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <!-- Background Track -->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/budget_progress_background" />

            <!-- Colored Progress (will be set programmatically) -->
            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:background="@drawable/budget_progress_fill" />

            <!-- Min Marker -->
            <View
                android:id="@+id/minMarker"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginTop="-2dp"
                android:background="@color/income_green" />

            <!-- Max Marker -->
            <View
                android:id="@+id/maxMarker"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginTop="-2dp"
                android:background="@color/expense_red" />

            <!-- Spent Marker -->
            <View
                android:id="@+id/spentMarker"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginTop="-2dp"
                android:background="@color/yellow_accent" />
        </FrameLayout>

        <!-- Zone Legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Below Min"
                android:textColor="@color/income_green"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Target Range"
                android:textColor="@color/yellow_accent"
                android:textSize="9sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Over Max"
                android:textColor="@color/expense_red"
                android:textSize="9sp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Budget Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:paddingTop="8dp"
        android:background="@color/medium_gray">

        <TextView
            android:id="@+id/tvBudgetAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>